GEMINI_API_KEY=your_key_here
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Per-model limits. Kept slightly under the real limits (15 RPM / 500 RPD) for headroom.
GEMINI_RPM=14
GEMINI_RPD=480
MAX_WORKERS=6
REQUEST_TIMEOUT=60s
MAX_RETRIES=3
PORT=8080
GENERATE_TIMEOUT=120s
# 127.0.0.1 keeps the API reachable only from your own computer.
HOST=127.0.0.1
